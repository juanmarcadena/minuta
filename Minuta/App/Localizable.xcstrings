    "Transcription by WhisperKit (Argmax). Speaker separation by SpeakerKit. MCP server built with the Model Context Protocol Swift SDK.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcripción con WhisperKit (Argmax). Separación de voces con SpeakerKit. Servidor MCP hecho con el SDK de Swift de Model Context Protocol."
          }
        }
      }
    },
    "Transcription failed for %@: %@. The audio was kept.": {
      "localizations": {
