      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay transcripciones"
          }
        }
      }
    },
    "No sound came from %@ during \"%@\". If the other side talked, turn on Minuta in System Settings → Privacy & Security → Screen & System Audio Recording.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No llegó sonido de %1$@ durante «%2$@». Si la otra persona habló, activa Minuta en Configuración del Sistema → Privacidad y seguridad → Grabación de pantalla y audio del sistema."
          }
        }
      }
    },
    "No speech was detected in this recording.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se detectó voz en esta grabación."
          }
        }
      }
    },
